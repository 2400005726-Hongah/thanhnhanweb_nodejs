generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("user_status")
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
  ARCHIVED

  @@map("customer_status")
}

enum RecordStatus {
  ACTIVE
  INACTIVE

  @@map("record_status")
}

enum BusStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE

  @@map("bus_status")
}

enum SeatType {
  NORMAL
  VIP
  SINGLE_ROOM
  DOUBLE_ROOM

  @@map("seat_type")
}

enum TripStatus {
  OPEN
  CLOSED
  DEPARTED
  COMPLETED
  CANCELLED

  @@map("trip_status")
}

enum TripSeatStatus {
  AVAILABLE
  HELD
  BOOKED

  @@map("trip_seat_status")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
  NO_SHOW
  DELETED

  @@map("booking_status")
}

enum BookingSource {
  ONLINE
  HOTLINE
  COUNTER

  @@map("booking_source")
}

enum NewsStatus {
  ACTIVE
  INACTIVE
  DRAFT
  PUBLISHED

  @@map("news_status")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum PaymentMethod {
  CASH
  COUNTER_CASH
  CASH_COUNTER
  BANK_TRANSFER
  BANK_QR
  MOMO
  ZALOPAY
  VNPAY
  POS
  CARD_POS
  PAY_AT_BUS
  SIMULATED

  @@map("payment_method")
}

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName          String     @map("full_name")
  username          String?    @unique
  email             String     @unique
  phone             String     @unique
  passwordHash      String     @map("password_hash")
  role              UserRole   @default(CUSTOMER)
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdTrips      Trip[]     @relation("TripCreatedBy")
  bookings          Booking[]  @relation("BookingUser")
  createdBookings   Booking[]  @relation("BookingCreatedBy")
  cancelledBookings Booking[]  @relation("BookingCancelledBy")
  deletedBookings   Booking[]  @relation("BookingDeletedBy")
  noShowBookings    Booking[]  @relation("BookingNoShowBy")
  blockedCustomers  Customer[] @relation("CustomerBlockedBy")
  createdNews       News[]     @relation("NewsCreatedBy")
  updatedNews       News[]     @relation("NewsUpdatedBy")
  auditLogs         AuditLog[]

  @@index([email])
  @@index([phone])
  @@index([role, status])
  @@map("users")
}

model Customer {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName      String         @map("full_name")
  phone         String         @unique
  email         String?
  status        CustomerStatus @default(ACTIVE)
  blockedReason String?        @map("blocked_reason")
  blockedAt     DateTime?      @map("blocked_at") @db.Timestamptz(6)
  blockedById   String?        @map("blocked_by_id") @db.Uuid
  note          String?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  blockedBy     User?          @relation("CustomerBlockedBy", fields: [blockedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  bookings      Booking[]

  @@index([status, fullName], map: "customers_status_name_idx")
  @@index([email])
  @@map("customers")
}

model Province {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String       @unique
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  areas     PickupDropoffArea[]
  locations Location[]

  @@index([status, name])
  @@map("provinces")
}

model PickupDropoffArea {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provinceId      String       @map("province_id") @db.Uuid
  legacyRegion    String?      @map("legacy_region")
  name            String
  detailedAddress String?      @map("detailed_address")
  sortOrder       Int          @default(0) @map("sort_order")
  status          RecordStatus @default(ACTIVE)
  isDeleted       Boolean      @default(false) @map("is_deleted")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  province        Province     @relation(fields: [provinceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  defaultLocations Location[]  @relation("LocationDefaultArea")
  locationFilters LocationAreaFilter[]
  routeStops      RouteStop[]

  @@unique([provinceId, name], map: "pickup_dropoff_areas_province_name_key")
  @@index([provinceId, isDeleted, status, sortOrder], map: "pickup_dropoff_areas_province_deleted_status_sort_idx")
  @@map("pickup_dropoff_areas")
}

model Location {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  normalizedName        String?      @map("normalized_name")
  province              String
  provinceId            String?      @map("province_id") @db.Uuid
  defaultAreaId         String?      @map("default_area_id") @db.Uuid
  address               String?
  locationType          String       @default("BOTH") @map("location_type")
  sortOrder             Int          @default(0) @map("sort_order")
  status                RecordStatus @default(ACTIVE)
  isDeleted             Boolean      @default(false) @map("is_deleted")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  provinceRef           Province?    @relation(fields: [provinceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  defaultArea           PickupDropoffArea? @relation("LocationDefaultArea", fields: [defaultAreaId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  areaFilters           LocationAreaFilter[]
  departureRoutes       Route[]      @relation("RouteDepartureLocation")
  arrivalRoutes         Route[]      @relation("RouteArrivalLocation")
  tripDepartureLocations Trip[]      @relation("TripDepartureSpecificLocation")
  tripArrivalLocations  Trip[]       @relation("TripArrivalSpecificLocation")
  tripServicePoints     TripServicePoint[]
  pickupBookings        Booking[]    @relation("BookingPickupLocation")
  dropoffBookings       Booking[]    @relation("BookingDropoffLocation")

  @@unique([name, province])
  @@unique([provinceId, normalizedName], map: "locations_province_normalized_name_key")
  @@index([province, status])
  @@index([provinceId, isDeleted, status, sortOrder], map: "locations_province_deleted_status_sort_idx")
  @@index([defaultAreaId])
  @@map("locations")
}

model LocationAreaFilter {
  locationId String            @map("location_id") @db.Uuid
  areaId     String            @map("area_id") @db.Uuid
  location   Location          @relation(fields: [locationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  area       PickupDropoffArea @relation(fields: [areaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([locationId, areaId])
  @@index([areaId, locationId], map: "location_area_filters_area_location_idx")
  @@map("location_area_filters")
}

model Route {
  id                       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeName                String       @map("route_name")
  description              String?
  departureLocationId      String       @map("departure_location_id") @db.Uuid
  arrivalLocationId        String       @map("arrival_location_id") @db.Uuid
  distanceKm               Decimal      @map("distance_km") @db.Decimal(10, 2)
  estimatedDurationMinutes Int          @map("estimated_duration_minutes")
  defaultTicketPrice       Decimal?     @map("default_ticket_price") @db.Decimal(12, 2)
  defaultSingleRoomPrice   Decimal?     @map("default_single_room_price") @db.Decimal(12, 2)
  defaultDoubleRoomPrice   Decimal?     @map("default_double_room_price") @db.Decimal(12, 2)
  status                   RecordStatus @default(ACTIVE)
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  departureLocation        Location     @relation("RouteDepartureLocation", fields: [departureLocationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  arrivalLocation          Location     @relation("RouteArrivalLocation", fields: [arrivalLocationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  trips                    Trip[]
  routeStops               RouteStop[]

  @@unique([departureLocationId, arrivalLocationId], map: "routes_departure_arrival_key")
  @@index([status, routeName], map: "routes_status_name_idx")
  @@map("routes")
}

model RouteStop {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId   String            @map("route_id") @db.Uuid
  areaId    String            @map("area_id") @db.Uuid
  pointType String            @map("point_type")
  sortOrder Int               @default(0) @map("sort_order")
  status    RecordStatus      @default(ACTIVE)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  route     Route             @relation(fields: [routeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  area      PickupDropoffArea @relation(fields: [areaId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([routeId, areaId, pointType], map: "route_stops_route_area_type_key")
  @@index([routeId, pointType, status, sortOrder], map: "route_stops_route_type_status_sort_idx")
  @@map("route_stops")
}

model Bus {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  busName      String    @map("bus_name")
  licensePlate String    @unique @map("license_plate")
  busType      String    @map("bus_type")
  capacity     Int
  status       BusStatus @default(ACTIVE)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  seats        Seat[]
  trips        Trip[]

  @@index([status, busType])
  @@map("buses")
}

model Seat {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  busId     String       @map("bus_id") @db.Uuid
  seatCode  String       @map("seat_code")
  floor     Int          @default(1)
  seatType  SeatType     @default(NORMAL) @map("seat_type")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bus       Bus          @relation(fields: [busId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tripSeats TripSeat[]

  @@unique([busId, seatCode], map: "seats_bus_seat_code_key")
  @@index([busId, status, seatType], map: "seats_bus_status_seat_type_idx")
  @@map("seats")
}

model Trip {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId             String?    @map("route_id") @db.Uuid
  busId               String     @map("bus_id") @db.Uuid
  departureTime       DateTime   @map("departure_time") @db.Timestamptz(6)
  expectedArrivalTime DateTime   @map("expected_arrival_time") @db.Timestamptz(6)
  departureLocationId String?    @map("departure_specific_location_id") @db.Uuid
  arrivalLocationId   String?    @map("arrival_specific_location_id") @db.Uuid
  primaryPickupMode   String     @default("DonTaiBenXe") @map("primary_pickup_mode")
  primaryDropoffMode  String     @default("TraTaiBenXe") @map("primary_dropoff_mode")
  allowPickupTransfer Boolean       @default(false) @map("allow_pickup_transfer")
  allowPickupMeetingPoint Boolean   @default(false) @map("allow_pickup_meeting_point")
  allowDropoffTransfer Boolean      @default(false) @map("allow_dropoff_transfer")
  allowDropoffStop     Boolean      @default(false) @map("allow_dropoff_stop")
  salesStatus          String     @default("OPEN") @map("sales_status")
  operationStatus      String     @default("NOT_DEPARTED") @map("operation_status")
  completedAt          DateTime?  @map("completed_at") @db.Timestamptz(6)
  ticketPrice         Decimal?   @map("ticket_price") @db.Decimal(12, 2)
  singleRoomPrice     Decimal?   @map("single_room_price") @db.Decimal(12, 2)
  doubleRoomPrice     Decimal?   @map("double_room_price") @db.Decimal(12, 2)
  status              TripStatus @default(OPEN)
  createdById         String?    @map("created_by_id") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  route               Route?     @relation(fields: [routeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  bus                 Bus        @relation(fields: [busId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdBy           User?      @relation("TripCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  departureLocation   Location?  @relation("TripDepartureSpecificLocation", fields: [departureLocationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  arrivalLocation     Location?  @relation("TripArrivalSpecificLocation", fields: [arrivalLocationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  servicePoints       TripServicePoint[]
  tripSeats           TripSeat[]
  bookings            Booking[]

  @@index([routeId, departureTime, status], map: "trips_route_departure_status_idx")
  @@index([busId, departureTime, expectedArrivalTime], map: "trips_bus_departure_arrival_idx")
  @@index([departureLocationId, arrivalLocationId, departureTime], map: "trips_specific_locations_departure_idx")
  @@index([salesStatus, operationStatus, departureTime], map: "trips_sales_operation_departure_idx")
  @@map("trips")
}

model TripServicePoint {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId                 String       @map("trip_id") @db.Uuid
  locationId             String       @map("location_id") @db.Uuid
  pointType              String       @map("point_type")
  serviceMode            String       @map("service_mode")
  estimatedMinutes      Int          @default(0) @map("estimated_minutes")
  estimatedTime          DateTime?    @map("estimated_time") @db.Time(0) // legacy: giữ để tương thích dữ liệu cũ
  isDefault              Boolean         @default(false) @map("is_default")
  sortOrder              Int          @default(0) @map("sort_order")
  status                 RecordStatus @default(ACTIVE)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  trip                   Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  location               Location     @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  pickupBookings         Booking[]    @relation("BookingPickupServicePoint")
  dropoffBookings        Booking[]    @relation("BookingDropoffServicePoint")

  @@unique([tripId, locationId, pointType, serviceMode], map: "trip_service_points_trip_location_type_mode_key")
  @@index([tripId, pointType, status, sortOrder], map: "trip_service_points_trip_type_status_sort_idx")
  @@index([locationId, status])
  @@map("trip_service_points")
}

model TripSeat {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId        String         @map("trip_id") @db.Uuid
  seatId        String         @map("seat_id") @db.Uuid
  seatCode      String         @map("seat_code")
  floor         Int
  seatType      SeatType       @map("seat_type")
  price         Decimal        @db.Decimal(12, 2)
  status        TripSeatStatus @default(AVAILABLE)
  heldBy        String?        @map("held_by")
  holdExpiresAt DateTime?      @map("hold_expires_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  seat          Seat           @relation(fields: [seatId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  bookingItems  BookingItem[]

  @@unique([tripId, seatId], map: "trip_seats_trip_seat_key")
  @@unique([tripId, seatCode], map: "trip_seats_trip_code_key")
  @@index([tripId, status], map: "trip_seats_trip_status_idx")
  @@index([holdExpiresAt])
  @@map("trip_seats")
}

model Booking {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingCode        String        @unique @map("booking_code")
  userId             String?       @map("user_id") @db.Uuid
  customerId         String?       @map("customer_id") @db.Uuid
  tripId             String        @map("trip_id") @db.Uuid
  source             BookingSource @default(ONLINE)
  passengerFullName  String        @map("passenger_full_name")
  passengerPhone     String        @map("passenger_phone")
  passengerEmail     String?       @map("passenger_email")
  customerNote       String?       @map("customer_note")
  staffNote          String?       @map("staff_note")
  pickupPoint        String?       @map("pickup_point")
  dropoffPoint       String?       @map("dropoff_point")
  pickupLocationId   String?       @map("pickup_location_id") @db.Uuid
  dropoffLocationId  String?       @map("dropoff_location_id") @db.Uuid
  pickupServicePointId String?      @map("pickup_service_point_id") @db.Uuid
  dropoffServicePointId String?     @map("dropoff_service_point_id") @db.Uuid
  pickupServiceMode  String?       @map("pickup_service_mode")
  dropoffServiceMode String?       @map("dropoff_service_mode")
  pickupKind         String?       @map("pickup_kind")
  dropoffKind        String?       @map("dropoff_kind")
  pickupRequestedAddress String?   @map("pickup_requested_address")
  dropoffRequestedAddress String?  @map("dropoff_requested_address")
  smsSent            Boolean          @default(false) @map("sms_sent")
  smsSentAt          DateTime?     @map("sms_sent_at") @db.Timestamptz(6)
  totalAmount        Decimal       @map("total_amount") @db.Decimal(12, 2)
  status             BookingStatus @default(PENDING)
  paymentStatus      PaymentStatus @default(PENDING) @map("payment_status")
  expiresAt          DateTime?     @map("expires_at") @db.Timestamptz(6)
  cancellationReason String?       @map("cancellation_reason")
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  cancelledById      String?       @map("cancelled_by_id") @db.Uuid
  noShowReason       String?       @map("no_show_reason")
  noShowAt           DateTime?     @map("no_show_at") @db.Timestamptz(6)
  noShowById         String?       @map("no_show_by_id") @db.Uuid
  deletedReason      String?       @map("deleted_reason")
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(6)
  deletedById        String?       @map("deleted_by_id") @db.Uuid
  createdById        String?       @map("created_by_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User?         @relation("BookingUser", fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  trip               Trip          @relation(fields: [tripId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdBy          User?         @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  cancelledBy        User?         @relation("BookingCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  noShowBy           User?         @relation("BookingNoShowBy", fields: [noShowById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  deletedBy          User?         @relation("BookingDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  pickupLocation     Location?     @relation("BookingPickupLocation", fields: [pickupLocationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  dropoffLocation    Location?     @relation("BookingDropoffLocation", fields: [dropoffLocationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  pickupServicePoint TripServicePoint? @relation("BookingPickupServicePoint", fields: [pickupServicePointId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  dropoffServicePoint TripServicePoint? @relation("BookingDropoffServicePoint", fields: [dropoffServicePointId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items              BookingItem[]
  payments           Payment[]

  @@index([userId, createdAt], map: "bookings_user_created_idx")
  @@index([customerId, createdAt], map: "bookings_customer_created_idx")
  @@index([customerId, status], map: "bookings_customer_status_idx")
  @@index([tripId, status], map: "bookings_trip_status_idx")
  @@index([source, status, paymentStatus, expiresAt], map: "bookings_source_status_payment_expiry_idx")
  @@index([source, createdAt], map: "bookings_source_created_idx")
  @@index([passengerPhone, bookingCode], map: "bookings_phone_code_idx")
  @@index([cancelledById])
  @@index([noShowById])
  @@index([deletedById])
  @@index([createdById])
  @@index([createdAt])
  @@index([pickupLocationId])
  @@index([dropoffLocationId])
  @@index([pickupServicePointId])
  @@index([dropoffServicePointId])
  @@map("bookings")
}

model BookingItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String   @map("booking_id") @db.Uuid
  tripSeatId String   @map("trip_seat_id") @db.Uuid
  seatCode   String   @map("seat_code")
  seatType   SeatType @map("seat_type")
  price      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tripSeat   TripSeat @relation(fields: [tripSeatId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([bookingId, tripSeatId])
  @@index([bookingId])
  @@index([tripSeatId])
  @@map("booking_items")
}

model Payment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String        @map("booking_id") @db.Uuid
  paymentMethod   PaymentMethod @map("payment_method")
  amount          Decimal       @db.Decimal(12, 2)
  transactionCode String?       @unique @map("transaction_code")
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([bookingId, status, createdAt], map: "payments_booking_status_created_idx")
  @@index([paymentMethod, status, createdAt], map: "payments_method_status_created_idx")
  @@map("payments")
}

model News {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  slug         String     @unique
  summary      String
  content      String
  thumbnailUrl String?    @map("thumbnail_url")
  status       NewsStatus @default(DRAFT)
  publishedAt  DateTime?  @map("published_at") @db.Timestamptz(6)
  createdById  String     @map("created_by_id") @db.Uuid
  updatedById  String?    @map("updated_by_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  viewCount    Int        @default(0) @map("view_count")
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdBy    User       @relation("NewsCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  updatedBy    User?      @relation("NewsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status, publishedAt])
  @@index([createdById, createdAt], map: "news_created_by_created_at_idx")
  @@index([updatedById])
  @@map("news")
}

model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  role        UserRole?
  actorName   String?   @map("actor_name")
  action      String
  entityType  String    @map("entity_type")
  entityId    String    @map("entity_id")
  description String
  reason      String?
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId, createdAt], map: "audit_logs_user_created_at_idx")
  @@index([entityType, entityId, createdAt], map: "audit_logs_entity_created_at_idx")
  @@index([createdAt])
  @@map("audit_logs")
}
