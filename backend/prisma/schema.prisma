generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum RecordStatus {
  ACTIVE
  INACTIVE

  @@map("record_status")
}

enum BusStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE

  @@map("bus_status")
}

enum SeatType {
  NORMAL
  VIP

  @@map("seat_type")
}

enum TripStatus {
  OPEN
  CLOSED
  DEPARTED
  COMPLETED
  CANCELLED

  @@map("trip_status")
}

enum TripSeatStatus {
  AVAILABLE
  HELD
  BOOKED

  @@map("trip_seat_status")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
  NO_SHOW

  @@map("booking_status")
}

enum NewsStatus {
  ACTIVE
  INACTIVE
  DRAFT
  PUBLISHED

  @@map("news_status")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  SIMULATED

  @@map("payment_method")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  fullName       String     @map("full_name")
  email          String     @unique
  phone          String     @unique
  passwordHash   String     @map("password_hash")
  role           UserRole   @default(CUSTOMER)
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdTrips   Trip[]     @relation("TripCreatedBy")
  bookings       Booking[]
  noShowBookings Booking[]  @relation("BookingNoShowBy")
  createdNews    News[]     @relation("NewsCreatedBy")
  updatedNews    News[]     @relation("NewsUpdatedBy")
  auditLogs      AuditLog[]

  @@index([status, role])
  @@map("users")
}

model Location {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  province        String
  address         String?
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  departureRoutes Route[]      @relation("RouteDepartureLocation")
  arrivalRoutes   Route[]      @relation("RouteArrivalLocation")

  @@unique([name, province])
  @@index([status, province, name])
  @@map("locations")
}

model Route {
  id                       String       @id @default(uuid()) @db.Uuid
  routeName                String       @map("route_name")
  departureLocationId      String       @map("departure_location_id") @db.Uuid
  arrivalLocationId        String       @map("arrival_location_id") @db.Uuid
  distanceKm               Decimal      @map("distance_km") @db.Decimal(10, 2)
  estimatedDurationMinutes Int          @map("estimated_duration_minutes")
  defaultTicketPrice       Decimal?     @map("default_ticket_price") @db.Decimal(12, 2)
  status                   RecordStatus @default(ACTIVE)
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  departureLocation        Location     @relation("RouteDepartureLocation", fields: [departureLocationId], references: [id], onDelete: Restrict)
  arrivalLocation          Location     @relation("RouteArrivalLocation", fields: [arrivalLocationId], references: [id], onDelete: Restrict)
  trips                    Trip[]

  @@unique([departureLocationId, arrivalLocationId])
  @@index([status, routeName])
  @@map("routes")
}

model Bus {
  id           String    @id @default(uuid()) @db.Uuid
  busName      String    @map("bus_name")
  licensePlate String    @unique @map("license_plate")
  busType      String    @map("bus_type")
  capacity     Int
  status       BusStatus @default(ACTIVE)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  seats        Seat[]
  trips        Trip[]

  @@index([status, busType])
  @@map("buses")
}

model Seat {
  id        String       @id @default(uuid()) @db.Uuid
  busId     String       @map("bus_id") @db.Uuid
  seatCode  String       @map("seat_code")
  floor     Int
  seatType  SeatType     @default(NORMAL) @map("seat_type")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  bus       Bus          @relation(fields: [busId], references: [id], onDelete: Restrict)
  tripSeats TripSeat[]

  @@unique([busId, seatCode])
  @@index([busId, status])
  @@map("seats")
}

model Trip {
  id                  String     @id @default(uuid()) @db.Uuid
  routeId             String     @map("route_id") @db.Uuid
  busId               String     @map("bus_id") @db.Uuid
  departureTime       DateTime   @map("departure_time") @db.Timestamptz(3)
  expectedArrivalTime DateTime   @map("expected_arrival_time") @db.Timestamptz(3)
  ticketPrice         Decimal    @map("ticket_price") @db.Decimal(12, 2)
  status              TripStatus @default(OPEN)
  createdById         String?    @map("created_by_id") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  route               Route      @relation(fields: [routeId], references: [id], onDelete: Restrict)
  bus                 Bus        @relation(fields: [busId], references: [id], onDelete: Restrict)
  createdBy           User?      @relation("TripCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tripSeats           TripSeat[]
  bookings            Booking[]

  @@index([routeId, departureTime, status])
  @@index([busId, departureTime, expectedArrivalTime])
  @@map("trips")
}

model TripSeat {
  id            String         @id @default(uuid()) @db.Uuid
  tripId        String         @map("trip_id") @db.Uuid
  seatId        String         @map("seat_id") @db.Uuid
  seatCode      String         @map("seat_code")
  floor         Int
  seatType      SeatType       @map("seat_type")
  price         Decimal        @db.Decimal(12, 2)
  status        TripSeatStatus @default(AVAILABLE)
  heldBy        String?        @map("held_by")
  holdExpiresAt DateTime?      @map("hold_expires_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Restrict)
  seat          Seat           @relation(fields: [seatId], references: [id], onDelete: Restrict)
  bookingItem   BookingItem?

  @@unique([tripId, seatId])
  @@unique([tripId, seatCode])
  @@index([tripId, status])
  @@index([status, holdExpiresAt])
  @@map("trip_seats")
}

model Booking {
  id                String        @id @default(uuid()) @db.Uuid
  bookingCode       String        @unique @map("booking_code")
  userId            String?       @map("user_id") @db.Uuid
  tripId            String        @map("trip_id") @db.Uuid
  passengerFullName String        @map("passenger_full_name")
  passengerPhone    String        @map("passenger_phone")
  passengerEmail    String?       @map("passenger_email")
  totalAmount       Decimal       @map("total_amount") @db.Decimal(12, 2)
  status            BookingStatus @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  expiresAt         DateTime?     @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  trip              Trip          @relation(fields: [tripId], references: [id], onDelete: Restrict)
  items             BookingItem[]
  payments          Payment[]
  noShowReason      String?       @map("no_show_reason")
  noShowAt          DateTime?     @map("no_show_at") @db.Timestamptz(3)
  noShowById        String?       @map("no_show_by_id") @db.Uuid
  noShowBy          User?         @relation("BookingNoShowBy", fields: [noShowById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([tripId, status])
  @@index([passengerPhone, bookingCode])
  @@index([noShowById])
  @@map("bookings")
}

model BookingItem {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @map("booking_id") @db.Uuid
  tripSeatId String   @unique @map("trip_seat_id") @db.Uuid
  seatCode   String   @map("seat_code")
  seatType   SeatType @map("seat_type")
  price      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  tripSeat   TripSeat @relation(fields: [tripSeatId], references: [id], onDelete: Restrict)

  @@unique([bookingId, tripSeatId])
  @@index([bookingId])
  @@map("booking_items")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @map("booking_id") @db.Uuid
  paymentMethod   PaymentMethod @map("payment_method")
  amount          Decimal       @db.Decimal(12, 2)
  transactionCode String?       @unique @map("transaction_code")
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId, status])
  @@map("payments")
}

model News {
  id           String     @id @default(uuid()) @db.Uuid
  title        String
  slug         String     @unique
  summary      String
  content      String
  thumbnailUrl String?    @map("thumbnail_url")
  status       NewsStatus @default(DRAFT)
  publishedAt  DateTime?  @map("published_at") @db.Timestamptz(3)
  createdById  String     @map("created_by_id") @db.Uuid
  updatedById  String?    @map("updated_by_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy    User       @relation("NewsCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?      @relation("NewsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([createdById, createdAt])
  @@index([updatedById])
  @@map("news")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        UserRole
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
